# Local development (without Docker)
DJANGO_ENV=development
SECRET_KEY=change-me-in-production
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Docker development (docker compose up)
# Uses PostgreSQL from docker-compose.yml — defaults work out of the box.
# POSTGRES_DB=backend
# POSTGRES_USER=backend
# POSTGRES_PASSWORD=backend
# WEB_PORT=8000

# Docker production (docker compose -f docker-compose.prod.yml up)
# DJANGO_ENV=production
# SECRET_KEY=your-long-random-secret-key
# ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
# CORS_ALLOWED_ORIGINS=https://yourdomain.com
# POSTGRES_DB=backend
# POSTGRES_USER=backend
# POSTGRES_PASSWORD=strong-password-here
# WEB_PORT=8000
# GUNICORN_WORKERS=3
# SECURE_SSL_REDIRECT=False
# SECURE_HSTS_SECONDS=0
#
# For a real HTTPS deployment behind a reverse proxy, set:
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
